{
    "compilerOptions": {
        "target": "es2016",
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "rootDir": "./"
    },
    "include": [
        "server.ts"
    ],
    "exclude": [
        "node_modules",
        "prisma.config.ts"
    ],
    "ts-node": {
        "compilerOptions": {
            "module": "commonjs"
        }
    }
}